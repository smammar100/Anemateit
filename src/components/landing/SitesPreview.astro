---
import Button from "@/components/fundations/elements/Button.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
import ProjectCard from "@/components/projects/ProjectCard.astro";
import { getAllProjects } from "@/lib/queries";

const projects = await getAllProjects();
const allTechs = [
  ...new Set(projects.flatMap((p) => p.technologies || [])),
];
const sortedTechs = allTechs.sort((a, b) => a.localeCompare(b));
const initialVisible = 7;
const step = initialVisible;
---

<section data-sites-preview data-step={step} data-initial={initialVisible}>
  <Wrapper variant="standard" class="py-24">
    {
      sortedTechs.length > 0 && (
        <div class="relative flex snap-x snap-proximity gap-1 py-2 overflow-x-scroll scrollbar-hide">
          {sortedTechs.map((tech) => (
            <Button
              isLink
              size="xs"
              variant="muted"
              title={tech}
              aria-label={tech}
              href={`/?tech=${encodeURIComponent(tech)}`}
              class="capitalize"
            >
              {tech}
            </Button>
          ))}
        </div>
      )
    }
    {
      projects.length === 0 ? (
        <div class="py-24 text-center text-base-500">
          No projects yet. Add one in the Sanity Studio.
        </div>
      ) : (
        <div
          class="grid grid-cols-1 gap-8 md:grid-cols-2 lg:grid-cols-4 mt-8"
          data-sites-list
        >
          {projects.map((project, i) => (
            <div data-site-card class={i >= initialVisible ? "hidden" : ""}>
              <ProjectCard project={project} />
            </div>
          ))}
        </div>
      )
    }
    {
      projects.length > initialVisible && (
        <div class="flex justify-center mt-10">
          <Button
            type="button"
            variant="muted"
            size="sm"
            data-sites-more
            class="px-6"
          >
            Show more
          </Button>
        </div>
      )
    }
  </Wrapper>
</section>

<script is:inline>
  (() => {
    const section = document.querySelector("[data-sites-preview]");
    if (!section) return;
    const cards = Array.from(section.querySelectorAll("[data-site-card]"));
    const button = section.querySelector("[data-sites-more]");
    const step = parseInt(section.dataset.step || "7", 10);
    let visible = parseInt(section.dataset.initial || "7", 10);

    const update = () => {
      cards.forEach((card, i) => {
        card.classList.toggle("hidden", i >= visible);
      });
      if (button) {
        button.classList.toggle("hidden", visible >= cards.length);
      }
    };

    button?.addEventListener("click", () => {
      visible += step;
      update();
    });

    update();
  })();
</script>
